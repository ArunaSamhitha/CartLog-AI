# Every key is optional. Anything missing falls back to mock data, so the app runs with none of them.

# Vision + text understanding and embeddings (needed for photo search)
OPENAI_API_KEY=
VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Semantic memory in Pinecone (otherwise stored locally in SQLite)
PINECONE_API_KEY=
PINECONE_INDEX=cartlog-memory

# Marketplace and research agents
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
RAINFOREST_API_KEY=
SERPER_API_KEY=

# Force mock mode even when keys are set
CARTLOG_MOCK=
